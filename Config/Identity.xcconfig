// The app's identity. This is the only file to edit when the name, bundle ID,
// team, or Google client changes; project.yml, Info.plist, and the entitlements
// read these values.
//
// PLACEHOLDERS: replace them before running on a device (docs/DEVICE-SETUP.md).
// CI builds without code signing, so placeholders are enough for it.
// Note: xcconfig treats "//" as a comment, so never put comments after a value.

// Working title. Change it any time.
APP_DISPLAY_NAME = Statline
APP_BUNDLE_ID = com.pwbeaton.statline
APP_GROUP_ID = group.$(APP_BUNDLE_ID)

// Invite links look like connector://join/CODE.
APP_URL_SCHEME = connector

// Your Apple Developer team ID (10 characters, from developer.apple.com → Membership).
DEVELOPMENT_TEAM = 6CTBZ2U8GC

// Google iOS OAuth client (docs/SETUP-GOOGLE.md). Paste only the part of the
// client ID before ".apps.googleusercontent.com", e.g. 1234567890-abc123def.
GOOGLE_CLIENT_ID_PREFIX = 51571390620-2i9at7rsh820h7p7i7844lo26ep6cmim
GOOGLE_IOS_CLIENT_ID = $(GOOGLE_CLIENT_ID_PREFIX).apps.googleusercontent.com
GOOGLE_URL_SCHEME = com.googleusercontent.apps.$(GOOGLE_CLIENT_ID_PREFIX)

// Supabase URL and anon key live in a local, uncommitted file.
// "#include?" means "include if it exists", so CI builds without it.
#include? "Secrets.xcconfig"
