// Copy this file to Config/Secrets.xcconfig (git-ignored) and fill in your values:
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Values come from the Supabase dashboard → Project Settings → API Keys.
// The anon (or "publishable") key is designed to ship inside apps: row-level
// security protects the data. NEVER put a service_role or secret key here.
//
// xcconfig files treat "//" as the start of a comment, so the URL is written
// with "$()" (an empty variable) between the two slashes.

SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-or-publishable-key

// For the local stack started with `supabase start`, use instead:
// SUPABASE_URL = http:/$()/127.0.0.1:54321
// SUPABASE_ANON_KEY = <the publishable/anon key printed by `supabase start`>
